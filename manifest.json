{
  "manifest_version": 3,
  "name": "TabFolio",
  "description": "Find and organize your tabs, protect your groups, review duplicates, and restore saved window layouts.",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "commands": {
    "open-tabfolio": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
      "description": "Open TabFolio"
    },
    "collapse-all-groups": {
      "suggested_key": {
        "default":    "Alt+Shift+C",
        "mac":        "Alt+Shift+C"
      },
      "description": "Collapse idle groups in the current window"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TabFolio"
  },
  "side_panel": { "default_path": "panel.html" },
  "options_ui": { "page": "settings.html", "open_in_tab": true }
}
